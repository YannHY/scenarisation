def die(message: str, code: int = 1) -> None:
    print(f"scenarisation: {message}", file=sys.stderr)
    raise SystemExit(code)


def slug(value: str) -> str:
    normalized = unicodedata.normalize("NFKD", value.strip().lower())
    ascii_value = normalized.encode("ascii", "ignore").decode("ascii")
    return re.sub(r"[^a-z0-9]+", "-", ascii_value).strip("-")


def lookup_school_system(value: str | None) -> str:
    token = slug(value or "")
    if not token:
        return ""
    for system_id, (label_fr, label_en, aliases) in SCHOOL_SYSTEMS.items():
        candidates = (system_id, label_fr, label_en, *aliases)
        if token in {slug(candidate) for candidate in candidates}:
            return system_id
    return ""


def lookup_school_level(value: str | None, system: str) -> str:
    token = slug(value or "")
    if not token or system not in SCHOOL_LEVELS:
        return ""
    for level_id, (label_fr, label_en, aliases) in SCHOOL_LEVELS[system].items():
        candidates = (level_id, label_fr, label_en, *aliases)
        if token in {slug(candidate) for candidate in candidates}:
            return level_id
    return ""


def resolve_school_system(value: str) -> str:
    system = lookup_school_system(value)
    if not system:
        die(f"invalid school system or classification: {value}. Run `scenarisation list school-systems`.")
    return system


def resolve_school_level(value: str, system: str) -> str:
    level = lookup_school_level(value, system)
    if not level:
        die(f"invalid school level for {system}: {value}. Run `scenarisation list school-levels --system {system}`.")
    return level


def school_system_for_level(level: str) -> str:
    matches = [system for system, levels in SCHOOL_LEVELS.items() if level in levels]
    return matches[0] if len(matches) == 1 else ""


def school_system_display(system: str, lang: str = "fr") -> str:
    if system not in SCHOOL_SYSTEMS:
        return system or "-"
    label_fr, label_en, _aliases = SCHOOL_SYSTEMS[system]
    return f"{system} ({label_en if lang == 'en' else label_fr})"


def school_level_display(level: str, system: str, lang: str = "fr") -> str:
    details = SCHOOL_LEVELS.get(system, {}).get(level)
    if not details:
        return level or "-"
    label_fr, label_en, _aliases = details
    return f"{level} ({label_en if lang == 'en' else label_fr})"


def now_id(prefix: str) -> str:
    return f"{prefix}-{int(time.time() * 1000)}"


def load_document(path: Path) -> dict[str, Any]:
    if not path.exists():
        die(f"file not found: {path}")
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as exc:
        die(f"invalid JSON in {path}: {exc}")
    if not isinstance(data, dict) or not isinstance(data.get("sessions"), list):
        die(f"{path} is not a Scenarisation document")
    return data


def save_document(path: Path, document: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(
        json.dumps(document, ensure_ascii=False, indent=2) + "\n",
        encoding="utf-8",
    )


def load_config() -> dict[str, Any]:
    if not CONFIG_PATH.exists():
        return {"sites": {}, "default_site": ""}
    try:
        data = json.loads(CONFIG_PATH.read_text(encoding="utf-8"))
    except json.JSONDecodeError:
        return {"sites": {}, "default_site": ""}
    if not isinstance(data, dict):
        return {"sites": {}, "default_site": ""}
    data.setdefault("sites", {})
    data.setdefault("default_site", "")
    return data


def save_config(config: dict[str, Any]) -> None:
    CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
    CONFIG_PATH.write_text(json.dumps(config, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    try:
        CONFIG_PATH.chmod(0o600)
    except OSError:
        pass


def normalize_site_url(site: str) -> str:
    value = site.strip().rstrip("/")
    if not value:
        die("site URL is required")
    if not re.match(r"^https?://", value, re.I):
        value = f"https://{value}"
    return value


def configured_site(args: argparse.Namespace) -> tuple[str, str]:
    config = load_config()
    raw_site = args.site or config.get("default_site") or DEFAULT_SITE
    site = normalize_site_url(raw_site)
    token = str(config.get("sites", {}).get(site, {}).get("token", "")).strip()
    if not token:
        die(
            "publication is not configured yet.\n"
            f"1. Open {site}/profile.php\n"
            "2. Create a CLI token in “Publication depuis le CLI”\n"
            "3. Run `scenarisation login` and paste the token\n"
            "4. Run `scenarisation publish <file>` again"
        )
    return site, token


def normalize(value: str | None, aliases: dict[str, str], field: str) -> str:
    if value is None:
        return ""
    token = slug(value)
    if token in aliases:
        return aliases[token]
    allowed = ", ".join(sorted(set(aliases.values())))
    die(f"invalid {field}: {value}. Expected one of: {allowed}")
    return ""


def normalize_aias(value: str) -> dict[str, Any]:
    token = slug(value)
    if token in {"1", "2", "3", "4", "5"}:
        return {"version": AIAS_VERSION, "status": "specified", "level": int(token)}
    if token in AIAS_STATUS_ALIASES:
        return {"version": AIAS_VERSION, "status": AIAS_STATUS_ALIASES[token], "level": None}
    die("invalid AIAS: " + value + ". Expected 1, 2, 3, 4, 5, not-applicable, or undecided")
    return {"version": AIAS_VERSION, "status": "undecided", "level": None}


def split_minutes(total: int, day_hours: int = DEFAULT_DAY_HOURS) -> tuple[int, int, int]:
    total = max(0, int(total))
    day_minutes = max(1, int(day_hours)) * 60
    days, rest = divmod(total, day_minutes)
    hours, minutes = divmod(rest, 60)
    return days, hours, minutes


def parse_links_as_markdown(raw_links: list[str]) -> str:
    links = []
    for raw in raw_links:
        title = ""
        url = raw
        if "=" in raw:
            title, url = raw.split("=", 1)
        elif "|" in raw:
            title, url = raw.split("|", 1)
        url = url.strip()
        title = title.strip() or url
        if url and not re.match(r"^[a-z][a-z0-9+.-]*:", url, re.I):
            url = f"https://{url}"
        if url:
            safe_title = title.replace("\\", "\\\\").replace("[", "\\[").replace("]", "\\]")
            links.append(f"[{safe_title}]({url})")
    return "\n".join(links)


def competency_id(reference: str) -> str:
    token = reference.strip()
    if not token:
        return ""
    if token.startswith("competency:"):
        return token
    match = re.fullmatch(r"([AaPpCc])\s*-?\s*(\d{1,2})", token)
    if match:
        level = {"a": "acquerir", "p": "approfondir", "c": "creer"}[match.group(1).lower()]
        return f"competency:{level}:{int(match.group(2))}"
    return token


def new_document(args: argparse.Namespace) -> dict[str, Any]:
    days, hours, minutes = split_minutes(args.duration or 0, args.day_hours)
    school_system = resolve_school_system(args.school_system) if args.school_system else ""
    if args.school_level and not school_system:
        die("--school-level requires --school-system")
    school_level = resolve_school_level(args.school_level, school_system) if args.school_level else ""
    return {
        "allNotesExpanded": False,
        "intentionsCollapsed": False,
        "topPanelCollapsed": False,
        "meta": {
            "name": args.title or "",
            "uiLanguage": args.lang,
            "dayHours": args.day_hours,
            "learningDays": days,
            "learningHours": hours,
            "learningMinutes": minutes,
            "modeDelivery": normalize(args.mode, LOCATION_ALIASES, "mode") if args.mode else "",
            "schoolSystem": school_system,
            "schoolLevel": school_level,
            "sizeClass": args.group_size or "",
            "designers": args.designers or "",
            "trainers": args.trainers or "",
            "description": args.description or "",
            "command": args.brief or "",
            "personas": args.objectives or "",
            "sliders": [],
            "activeTab": "settings",
            "boardLayout": "columns",
        },
        "sessions": [],
        "partitionLineConfig": [
            {"type": "locationMode", "label": "En classe", "value": "onsite", "visible": True},
            {"type": "locationMode", "label": "Sur site", "value": "location_based", "visible": True},
            {"type": "locationMode", "label": "En ligne", "value": "online", "visible": True},
            {"type": "locationMode", "label": "Hybride", "value": "hybrid", "visible": True},
            {"type": "locationMode", "label": "Autre", "value": "other", "visible": True},
        ],
    }


def find_session(document: dict[str, Any], selector: str | None) -> dict[str, Any]:
    sessions = document["sessions"]
    if not sessions:
        die("no moment found. Create one with `scenarisation add-moment ...`")
    if not selector:
        return sessions[-1]
    if selector.isdigit():
        index = int(selector) - 1
        if 0 <= index < len(sessions):
            return sessions[index]
        die(f"moment index out of range: {selector}")
    for session in sessions:
        if slug(str(session.get("id", ""))) == slug(selector) or slug(str(session.get("title", ""))) == slug(selector):
            return session
    die(f"moment not found: {selector}")
    return sessions[-1]


def command_init(args: argparse.Namespace) -> None:
    path = Path(args.file)
    if path.exists() and not args.force:
        die(f"{path} already exists. Use --force to overwrite.")
    document = new_document(args)
    save_document(path, document)
    print(f"Created {path}")


def command_add_moment(args: argparse.Namespace) -> None:
    path = Path(args.file)
    document = load_document(path)
    document["sessions"].append(
        {
            "id": now_id("moment"),
            "title": args.title,
            "objectives": args.objectives or "",
            "intentions": args.intentions or "",
            "notes": args.notes or "",
            "notesExpanded": False,
            "activities": [],
        }
    )
    save_document(path, document)
    print(f"Added moment {len(document['sessions'])}: {args.title}")


def command_add_activity(args: argparse.Namespace) -> None:
    path = Path(args.file)
    document = load_document(path)
    session = find_session(document, args.moment)
    activity_type = normalize(args.type, ALIASES, "type")
    tools = [competency_id(item) for raw in args.competencies for item in raw.split(",")]
    tools = [item for item in tools if item]
    description = (args.description or "").strip()
    markdown_links = parse_links_as_markdown(args.link)
    if markdown_links:
        description = "\n\n".join(part for part in (description, markdown_links) if part)
    session["activities"].append(
        {
            "id": now_id("activity"),
            "type": activity_type,
            "duration": max(1, int(args.duration)),
            "groupMode": normalize(args.group, GROUP_ALIASES, "group"),
            "teachingMode": normalize(args.teaching, TEACHING_ALIASES, "teaching"),
            "syncMode": normalize(args.pacing, SYNC_ALIASES, "pacing"),
            "locationMode": normalize(args.mode, ACTIVITY_LOCATION_ALIASES, "mode"),
            "evaluationMode": normalize(args.evaluation, EVAL_ALIASES, "evaluation"),
            "aias": normalize_aias(args.aias),
            "description": description,
            "instructions": args.instructions or "",
            "notes": args.notes or "",
            "tools": tools,
        }
    )
    save_document(path, document)
    print(f"Added activity to {session.get('title')}: {LEARNING_TYPES[activity_type][0]}")


def command_outcome(args: argparse.Namespace) -> None:
    path = Path(args.file)
    document = load_document(path)
    token = slug(args.bloom)
    if token not in BLOOM:
        die("invalid Bloom level. Use remember/understand/apply/analyze/evaluate/create or FR equivalents.")
    level_id, label_en, label_fr = BLOOM[token]
    lang = document.get("meta", {}).get("uiLanguage", "fr")
    document.setdefault("meta", {}).setdefault("sliders", []).append(
        {
            "id": now_id("outcome"),
            "category": level_id,
            "categoryLabel": label_en if lang == "en" else label_fr,
            "verb": args.verb,
            "text": args.text,
        }
    )
    save_document(path, document)
    print(f"Added Bloom outcome: {args.verb} - {args.text}")


def learning_time(document: dict[str, Any]) -> str:
    meta = document.get("meta", {})
    parts = []
    for key, unit in (("learningDays", "d"), ("learningHours", "h"), ("learningMinutes", "min")):
        value = int(meta.get(key) or 0)
        if value:
            parts.append(f"{value}{unit}")
    return " ".join(parts) or "0min"


def summarize_document(document: dict[str, Any]) -> str:
    meta = document.get("meta", {})
    language = meta.get("uiLanguage", "fr")
    raw_school_level = str(meta.get("schoolLevel") or "")
    raw_school_system = str(meta.get("schoolSystem") or "")
    school_system = lookup_school_system(raw_school_system) or school_system_for_level(raw_school_level)
    school_level = lookup_school_level(raw_school_level, school_system) or raw_school_level
    school_system_for_display = school_system or raw_school_system
    lines = [
        f"# {meta.get('name') or 'Learning design'}",
        "",
        f"- Language: {language}",
        f"- Delivery mode: {meta.get('modeDelivery') or '-'}",
        f"- School system / classification: {school_system_display(school_system_for_display, language)}",
        f"- School level: {school_level_display(school_level, school_system, language)}",
        f"- Group size: {meta.get('sizeClass') or '-'}",
        f"- Designers: {meta.get('designers') or '-'}",
        f"- Trainers: {meta.get('trainers') or '-'}",
        f"- Learning time: {learning_time(document)}",
    ]
    if meta.get("description"):
        lines.append(f"- Description: {meta['description']}")
    if meta.get("command"):
        lines.append(f"- Institutional brief: {meta['command']}")
    if meta.get("personas"):
        lines.append(f"- Learning objectives/personas: {meta['personas']}")
    outcomes = meta.get("sliders") or []
    if outcomes:
        lines.extend(["", "## Bloom learning outcomes"])
        for outcome in outcomes:
            prefix = " / ".join(filter(None, [outcome.get("categoryLabel"), outcome.get("verb")]))
            lines.append(f"- {prefix}: {outcome.get('text', '')}")
    lines.extend(["", "## Moments"])
    for session_index, session in enumerate(document.get("sessions", []), start=1):
        lines.append(f"{session_index}. {session.get('title') or 'Moment'}")
        if session.get("objectives"):
            lines.append(f"   Objectives: {session['objectives']}")
        if session.get("intentions"):
            lines.append(f"   Pedagogical choices: {session['intentions']}")
        for activity_index, activity in enumerate(session.get("activities", []), start=1):
            type_label = LEARNING_TYPES.get(activity.get("type"), ("Undefined", "Undefined"))[1]
            aias = activity.get("aias") if isinstance(activity.get("aias"), dict) else {}
            aias_label = f"AIAS {aias.get('level')}" if aias.get("status") == "specified" else aias.get("status", "undecided")
            teaching_mode = activity.get("teachingMode")
            if not teaching_mode:
                teaching_mode = "independent" if activity.get("teacherPresence") == "absent" else "undefined"
            lines.append(
                "   "
                f"{session_index}.{activity_index} {type_label}, "
                f"{activity.get('duration')} min, "
                f"group={activity.get('groupMode')}, "
                f"teaching={teaching_mode}, "
                f"pacing={activity.get('syncMode')}, "
                f"mode={activity.get('locationMode')}, "
                f"assessment={activity.get('evaluationMode')}, "
                f"aias={aias_label}"
            )
            if activity.get("description"):
                lines.append(f"      Description: {activity['description']}")
            if activity.get("instructions"):
                lines.append(f"      Instructions for students: {activity['instructions']}")
            if activity.get("tools"):
                lines.append(f"      Digital competencies: {', '.join(activity['tools'])}")
    return "\n".join(lines)


def build_codex_prompt(document: dict[str, Any], args: argparse.Namespace) -> str:
    language = args.lang or document.get("meta", {}).get("uiLanguage", "fr")
    target = "French" if language == "fr" else "English"
    return "\n".join(
        [
            f"You are Codex. Create or improve a Scenarisation pedagogical design in {target}.",
            "",
            "Use the Scenarisation structure: moments, learning activity type, duration, group mode,",
            "teaching mode, pacing, delivery mode, assessment mode, AIAS, Bloom learning outcomes,",
            "and digital competencies. Keep the design importable as Scenarisation JSON.",
            "For every activity, make a deliberate and coherent pedagogical choice for group, teaching,",
            "pacing, delivery, assessment, and AIAS. Do not leave AIAS undecided. Base these choices on",
            "the objective, learner autonomy, required interactions, constraints, and evidence of learning.",
            "",
            "Return:",
            "1. A short pedagogical rationale.",
            "2. The complete updated design as JSON.",
            "3. Any assumptions or missing information.",
            "",
            "Current design:",
            summarize_document(document),
        ]
    )


def command_prompt(args: argparse.Namespace) -> None:
    document = load_document(Path(args.file))
    prompt = build_codex_prompt(document, args)
    if args.output:
        Path(args.output).write_text(prompt + "\n", encoding="utf-8")
        print(f"Wrote {args.output}")
    else:
        print(prompt)


def command_handoff(args: argparse.Namespace) -> None:
    document = load_document(Path(args.file))
    prompt = build_codex_prompt(document, args)
    if args.output:
        Path(args.output).write_text(prompt + "\n", encoding="utf-8")
        print(f"Wrote {args.output}")
    if args.dry_run:
        print(prompt)
        return
    command = args.codex_command or os.environ.get("SCENARISATION_CODEX_CMD") or os.environ.get("LEARNING_CODEX_CMD", "codex")
    if not shutil.which(command):
        die(f"Codex command not found: {command}. Use `scenarisation prompt` or set SCENARISATION_CODEX_CMD.")
    try:
        subprocess.run([command], input=prompt, text=True, check=True)
    except subprocess.CalledProcessError as exc:
        die(f"Codex command failed with exit code {exc.returncode}", exc.returncode)


def command_validate(args: argparse.Namespace) -> None:
    document = load_document(Path(args.file))
    warnings = []
    meta = document.get("meta", {})
    if not meta.get("name"):
        warnings.append("missing design title")
    raw_school_system = str(meta.get("schoolSystem") or "")
    raw_school_level = str(meta.get("schoolLevel") or "")
    school_system = lookup_school_system(raw_school_system)
    if raw_school_system and not school_system:
        warnings.append(f"invalid school system or classification: {raw_school_system}")
    if raw_school_level:
        if school_system and not lookup_school_level(raw_school_level, school_system):
            warnings.append(f"invalid school level for {school_system}: {raw_school_level}")
        elif not raw_school_system and not school_system_for_level(raw_school_level):
            warnings.append(f"school level has no recognised school system: {raw_school_level}")
    for s_index, session in enumerate(document.get("sessions", []), start=1):
        if not session.get("title"):
            warnings.append(f"moment {s_index}: missing title")
        for a_index, activity in enumerate(session.get("activities", []), start=1):
            prefix = f"moment {s_index}, activity {a_index}"
            if activity.get("type") not in LEARNING_TYPES:
                warnings.append(f"{prefix}: invalid learning type")
            if int(activity.get("duration") or 0) <= 0:
                warnings.append(f"{prefix}: invalid duration")
            if activity.get("groupMode") not in GROUP_MODES:
                warnings.append(f"{prefix}: invalid or missing group mode")
            if activity.get("teachingMode") not in set(TEACHING_ALIASES.values()):
                warnings.append(f"{prefix}: invalid or missing teaching mode")
            if activity.get("syncMode") not in set(SYNC_ALIASES.values()):
                warnings.append(f"{prefix}: invalid or missing pacing")
            if activity.get("locationMode") not in set(ACTIVITY_LOCATION_ALIASES.values()):
                warnings.append(f"{prefix}: invalid or missing delivery mode")
            if activity.get("evaluationMode") not in set(EVAL_ALIASES.values()):
                warnings.append(f"{prefix}: invalid or missing evaluation mode")
            aias = activity.get("aias") if isinstance(activity.get("aias"), dict) else {}
            aias_status = aias.get("status")
            aias_level = aias.get("level")
            if aias_status not in {"specified", "not_applicable", "undecided"}:
                warnings.append(f"{prefix}: invalid or missing AIAS choice")
            elif aias_status == "specified" and aias_level not in AIAS_DESCRIPTIONS:
                warnings.append(f"{prefix}: invalid AIAS level")
            elif aias_status != "specified" and aias_level is not None:
                warnings.append(f"{prefix}: AIAS level must be empty for status {aias_status}")
            if args.strict_pedagogy and activity.get("teachingMode") == "undefined":
                warnings.append(f"{prefix}: teaching mode is still undecided")
            if args.strict_pedagogy and aias_status == "undecided":
                warnings.append(f"{prefix}: AIAS is still undecided")
    if warnings:
        for warning in warnings:
            print(f"warning: {warning}")
        raise SystemExit(1)
    print("OK")


def command_list(args: argparse.Namespace) -> None:
    if args.kind == "types":
        for key, (fr, en) in LEARNING_TYPES.items():
            print(f"{key:12} {fr} / {en}")
    elif args.kind == "bloom":
        seen = set()
        for key, (level_id, en, fr) in BLOOM.items():
            if level_id not in seen:
                print(f"{level_id:12} {fr} / {en}")
                seen.add(level_id)
    elif args.kind == "competencies":
        print("Use A1-A30, P1-P35, C1-C30, or full ids such as competency:acquerir:14.")
    elif args.kind == "activity-options":
        print("group: whole, subgroups, individual")
        print("teaching: directed, guided, supported, independent")
        print("pacing: sync, async")
        print("mode: onsite, location-based, online, blended, other")
        print("evaluation: none, diagnostic, formative, summative, certificative")
        print("AIAS:")
        for level, description in AIAS_DESCRIPTIONS.items():
            print(f"  {level}: {description}")
        print("  not-applicable: the AIAS framework genuinely does not apply to the activity")
        print("  undecided: temporarily leave the choice open")
    elif args.kind == "school-systems":
        for system_id, (label_fr, label_en, _aliases) in SCHOOL_SYSTEMS.items():
            print(f"{system_id:22} {label_fr} / {label_en}")
    elif args.kind == "school-levels":
        if not args.system:
            die("--system is required with `scenarisation list school-levels`")
        system = resolve_school_system(args.system)
        for level_id, (label_fr, label_en, _aliases) in SCHOOL_LEVELS[system].items():
            print(f"{level_id:32} {label_fr} / {label_en}")
    else:
        die("unknown list kind")


def command_login(args: argparse.Namespace) -> None:
    site = normalize_site_url(args.site or DEFAULT_SITE)
    print(f"Site: {site}")
    token = (args.token or "").strip()
    if not token:
        print("Create a CLI token from your profile page, then paste it here.")
        print(f"Profile: {site}/profile.php")
        token = input("CLI token: ").strip()
    if not token:
        die("token is required")
    config = load_config()
    config.setdefault("sites", {})[site] = {"token": token}
    config["default_site"] = site
    save_config(config)
    print(f"Saved CLI token for {site}")


def command_publish(args: argparse.Namespace) -> None:
    path = Path(args.file)
    document = load_document(path)
    site, token = configured_site(args)
    title = args.title or document.get("meta", {}).get("name") or path.stem
    payload = {
        "title": title,
        "document": document,
    }
    if args.design_id:
        payload["design_id"] = int(args.design_id)

    request = urllib.request.Request(
        f"{site}/cli_publish.php",
        data=json.dumps(payload, ensure_ascii=False).encode("utf-8"),
        headers={
            "Authorization": f"Bearer {token}",
            "X-Learning-CLI-Token": token,
            "Content-Type": "application/json; charset=UTF-8",
            "Accept": "application/json",
            "User-Agent": f"scenarisation-cli/{VERSION}",
        },
        method="POST",
    )
    try:
        with urllib.request.urlopen(request, timeout=args.timeout) as response:
            raw = response.read().decode("utf-8")
    except urllib.error.HTTPError as exc:
        body = exc.read().decode("utf-8", errors="replace")
        die(f"publish failed ({exc.code}): {body}")
    except urllib.error.URLError as exc:
        die(f"publish failed: {exc.reason}")

    try:
        result = json.loads(raw)
    except json.JSONDecodeError:
        die(f"publish returned invalid JSON: {raw}")
    if not result.get("success"):
        die(f"publish failed: {result.get('error') or raw}")

    share_url = result.get("share_url", "")
    design = result.get("design", {}) if isinstance(result.get("design"), dict) else {}
    print(f"Published {design.get('title') or title}")
    if design.get("id"):
        print(f"Design ID: {design['id']}")
    if share_url:
        print(share_url)


def command_status(args: argparse.Namespace) -> None:
    config = load_config()
    default_site = config.get("default_site") or DEFAULT_SITE
    print(f"scenarisation {VERSION}")
    print(f"Default site: {default_site}")
    site_config = config.get("sites", {}).get(default_site, {})
    print("Publishing: configured" if site_config.get("token") else "Publishing: not configured")
    print(f"Config: {CONFIG_PATH}")


def command_upgrade(args: argparse.Namespace) -> None:
    print("Downloading the latest Scenarisation CLI installer...")
    try:
        with urllib.request.urlopen(INSTALL_URL, timeout=args.timeout) as response:
            script = response.read()
    except urllib.error.HTTPError as exc:
        die(f"upgrade failed ({exc.code}): {exc.reason}")
    except urllib.error.URLError as exc:
        die(f"upgrade failed: {exc.reason}")

    try:
        subprocess.run(["sh"], input=script, check=True)
    except subprocess.CalledProcessError as exc:
        die(f"upgrade installer failed with exit code {exc.returncode}", exc.returncode)


def add_common_design_args(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--title", "--titre", default="", help="Design title / titre du design")
    parser.add_argument("--lang", choices=["fr", "en"], default="fr", help="UI language")
    parser.add_argument("--duration", "--duree", "--durée", type=int, default=0, help="Total learning duration in minutes")
    parser.add_argument("--day-hours", "--heures-jour", type=int, default=DEFAULT_DAY_HOURS)
    parser.add_argument("--mode", default="", help="onsite/online/hybrid or presentiel/distanciel/hybride")
    parser.add_argument(
        "--school-system", "--systeme-scolaire", "--système-scolaire",
        default="",
        help="School system/classification id or label; see `scenarisation list school-systems`",
    )
    parser.add_argument(
        "--school-level", "--niveau-scolaire", "--niveau",
        default="",
        help="Level id or label for --school-system; see `scenarisation list school-levels --system ID`",
    )
    parser.add_argument("--group-size", "--taille-groupe", default="")
    parser.add_argument("--designers", "--concepteurs", default="")
    parser.add_argument("--trainers", "--formateurs", default="")
    parser.add_argument("--description", default="")
    parser.add_argument("--brief", "--commande", default="", help="Institutional brief / commande")
    parser.add_argument("--objectives", "--objectifs", default="", help="Overall learning objectives")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="scenarisation",
        description="Create Scenarisation files and Codex prompts from the terminal.",
    )
    parser.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    sub = parser.add_subparsers(dest="command", required=True)

    init = sub.add_parser("init", aliases=["nouveau"], help="Create a new design JSON file")
    init.add_argument("file", help="Output JSON file")
    init.add_argument("--force", action="store_true")
    add_common_design_args(init)
    init.set_defaults(func=command_init)

    moment = sub.add_parser("add-moment", aliases=["ajouter-moment"], help="Add a learning moment")
    moment.add_argument("file")
    moment.add_argument("--title", "--titre", required=True)
    moment.add_argument("--objectives", "--objectifs", default="")
    moment.add_argument("--intentions", "--choix", default="")
    moment.add_argument("--notes", default="")
    moment.set_defaults(func=command_add_moment)

    activity = sub.add_parser("add-activity", aliases=["ajouter-activite", "ajouter-activité"], help="Add an activity to a moment")
    activity.add_argument("file")
    activity.add_argument("--moment", help="Moment index, id, or title. Defaults to the last moment.")
    activity.add_argument("--type", required=True, help="read/investigate/practice/produce/discuss/collaborate")
    activity.add_argument("--duration", "--duree", "--durée", type=int, required=True)
    activity.add_argument(
        "--group", "--groupe", required=True,
        help="whole/subgroups/individual; choose explicitly for this activity",
    )
    activity.add_argument(
        "--teaching", "--enseignement", "--teacher", "--enseignant",
        dest="teaching",
        required=True,
        help="directed/guided/supported/independent (or French equivalents)",
    )
    activity.add_argument(
        "--pacing", "--rythme", required=True,
        help="sync/async (or French equivalents); choose explicitly for this activity",
    )
    activity.add_argument(
        "--mode",
        required=True,
        help="classroom-based/location-based/online/blended/other (or French equivalents)",
    )
    activity.add_argument(
        "--evaluation", "--évaluation", "--assessment", required=True,
        help="none/diagnostic/formative/summative/certificative",
    )
    activity.add_argument(
        "--aias", "--aias-level", required=True,
        help="1-5, not-applicable, or undecided; choose explicitly for this activity",
    )
    activity.add_argument("--description", default="")
    activity.add_argument("--instructions", "--consignes", default="")
    activity.add_argument("--notes", default="")
    activity.add_argument(
        "--competencies",
        "--competences",
        "--compétences",
        action="append",
        default=[],
        help="Comma-separated digital competencies: A1,P6,C14 or competency ids",
    )
    activity.add_argument(
        "--link", "--lien", action="append", default=[],
        help="title=url or url; appended to the description as Markdown",
    )
    activity.set_defaults(func=command_add_activity)

    outcome = sub.add_parser("outcome", aliases=["acquis"], help="Add a Bloom scenarisation outcome")
    outcome.add_argument("file")
    outcome.add_argument("--bloom", required=True, help="remember/understand/apply/analyze/evaluate/create")
    outcome.add_argument("--verb", "--verbe", required=True)
    outcome.add_argument("--text", "--texte", required=True)
    outcome.set_defaults(func=command_outcome)

    prompt = sub.add_parser("prompt", aliases=["codex-prompt"], help="Print a Codex handoff prompt")
    prompt.add_argument("file")
    prompt.add_argument("--lang", choices=["fr", "en"])
    prompt.add_argument("--output", "-o")
    prompt.set_defaults(func=command_prompt)

    handoff = sub.add_parser("handoff", aliases=["confier-codex", "codex"], help="Send the design prompt to Codex")
    handoff.add_argument("file")
    handoff.add_argument("--lang", choices=["fr", "en"])
    handoff.add_argument("--output", "-o")
    handoff.add_argument("--dry-run", action="store_true")
    handoff.add_argument("--codex-command", help="Codex executable name/path")
    handoff.set_defaults(func=command_handoff)

    validate = sub.add_parser("validate", aliases=["verifier", "vérifier"], help="Validate a design file")
    validate.add_argument("file")
    validate.add_argument(
        "--strict-pedagogy", action="store_true",
        help="also reject undecided teaching and AIAS choices",
    )
    validate.set_defaults(func=command_validate)

    list_cmd = sub.add_parser("list", aliases=["lister"], help="List accepted values")
    list_cmd.add_argument(
        "kind",
        choices=["types", "bloom", "competencies", "activity-options", "school-systems", "school-levels"],
    )
    list_cmd.add_argument("--system", "--school-system", "--système", default="")
    list_cmd.set_defaults(func=command_list)

    login = sub.add_parser("login", aliases=["connexion"], help="Save a CLI publishing token")
    login.add_argument("--site", default=DEFAULT_SITE, help=f"Scenarisation site URL. Defaults to {DEFAULT_SITE}")
    login.add_argument("--token", help="CLI token generated from the profile page")
    login.set_defaults(func=command_login)

    publish = sub.add_parser("publish", aliases=["publier"], help="Publish a design JSON file online")
    publish.add_argument("file")
    publish.add_argument("--site", help="Scenarisation site URL. Defaults to the last login site.")
    publish.add_argument("--title", "--titre", help="Published design title")
    publish.add_argument("--design-id", type=int, help="Update an existing online design id")
    publish.add_argument("--timeout", type=int, default=30)
    publish.set_defaults(func=command_publish)

    status = sub.add_parser("status", aliases=["etat", "état"], help="Show CLI version and publishing setup")
    status.set_defaults(func=command_status)

    upgrade = sub.add_parser("upgrade", aliases=["update", "mise-a-jour"], help="Install the latest CLI version")
    upgrade.add_argument("--timeout", type=int, default=30)
    upgrade.set_defaults(func=command_upgrade)
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    args.func(args)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
